{
  "name": "@ferii/dsh-wallpaper",
  "version": "1.0.0",
  "type": "module",
  "description": "Background image for the DeepSeek Harness Web UI: upload a local image, keep it on the Harness host, and show it behind the window with original/clear/balanced/soft effects.",
  "license": "MIT",
  "author": "ferii-87",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ferii-87/ferii-dsh-wallpaper.git"
  },
  "homepage": "https://github.com/ferii-87/ferii-dsh-wallpaper#readme",
  "bugs": {
    "url": "https://github.com/ferii-87/ferii-dsh-wallpaper/issues"
  },
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "wallpaper",
    "background",
    "theme"
  ],
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-theme",
        "@deepseek-ai/dsh-client-ui-settings-general"
      ]
    }
  },
  "publishConfig": {
    "access": "public"
  }
}
